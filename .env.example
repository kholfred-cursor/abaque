# ──────────────────────────────────────────────────────────────
# Abaque — variables d'environnement
# Copier en .env avant de démarrer. Ne jamais commiter .env.
# ──────────────────────────────────────────────────────────────

# development | production
ENVIRONMENT=development

# ── MongoDB (réplica set obligatoire) ──
MONGODB_URI=mongodb://mongo:27017/abaque?replicaSet=rs0
DATABASE_NAME=abaque
MONGO_SLOWMS=200

# ── Secrets : obligatoires et TOUS DIFFÉRENTS, sinon refus de démarrer ──
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-me
# Clé dédiée aux empreintes de vote. Ne jamais la réutiliser ailleurs.
# Ne jamais la changer tant qu'une version est ouverte.
CREDENTIAL_HMAC_KEY=change-me
# 16 caractères minimum
IP_HASH_SALT=change-me

# ── Authentification ──
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# false en développement http ; true obligatoire en production
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173

# ── Inscription ──
# true en développement ; false par défaut en production jusqu'au lot 5
SIGNUP_ENABLED=true

# ── Seed de démonstration (développement uniquement, interdit en production) ──
SEED_DEMO=true

# ── Processus ──
RATE_LIMIT_BACKEND=memory
# 1 obligatoire tant que RATE_LIMIT_BACKEND=memory (D013)
WEB_CONCURRENCY=1
